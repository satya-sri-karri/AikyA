# MongoDB connection string
# Local: mongodb://localhost:27017/campusx
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusx
MONGODB_URI=mongodb://localhost:27017/campusx

# LLM API key - keep this only in the backend .env file, never in the frontend.
# Currently using Groq (free tier): get a key at https://console.groq.com
AI_API_KEY=

# LLM model to use (Groq free-tier chat model)
AI_MODEL=qwen/qwen3.8-27b

# LLM base URL (OpenAI-compatible endpoint). To switch providers just change
# this + AI_API_KEY + AI_MODEL:
#   Groq:        https://api.groq.com/openai/v1
#   xAI Grok:    https://api.x.ai/v1   (model: grok-4.6)
#   Local Ollama: http://localhost:11434/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# Port the server runs on
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173